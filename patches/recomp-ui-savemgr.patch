+/*
+ * Optional card strip: one item the hook claims renders as a strip of image
+ * tiles instead of a row -- a selector whose value the cards show (the save
+ * manager's "State slot" with its screenshots is the motivating case, but
+ * nothing here knows that). The strip's highlighted card follows the item's
+ * *value*, not the row selection, so it stays put while the player walks
+ * down to the action rows that act on it.
+ *
+ * for_item is called for each visible page item per frame. It returns the
+ * card count to claim the item (0: an ordinary row), filling cards[0..count)
+ * and *active with the highlighted card's index. image is a backend-specific
+ * handle (the ImGui one: an ImTextureID); NULL renders a placeholder tile.
+ */
+typedef struct RecompRuntimeUiCardView {
+    void *image;
+    float aspect;
+    const char *caption;   /* drawn under the tile; may be NULL */
+} RecompRuntimeUiCardView;
+
+typedef struct RecompRuntimeUiPreview {
+    void *context;
+    int (*for_item)(void *context, const RecompRuntimeUiItem *item,
+                    RecompRuntimeUiCardView *cards, int card_max, int *active);
+    /* Non-zero when the item IS the strip's row: Up / Down pass over it and
+     * Accept is a no-op there -- a strip's value is chosen with Left / Right
+     * or a card tap, never by row selection. */
+    int (*is_strip)(void *context, const RecompRuntimeUiItem *item);
+} RecompRuntimeUiPreview;
+
