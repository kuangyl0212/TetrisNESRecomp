+// The card strip replacing a claimed row (a selector): the highlighted card
+// is the item's current value, NOT the row selection, so it stays put while
+// the player walks down to the rows that act on it. Clicking a card sets the
+// value; Left / Right on the row steps it (the model's ordinary CHOICE path).
+void draw_cards(RecompRuntimeUi *ui, const LauncherTheme &theme,
+                size_t strip_row, const RecompRuntimeUiItem *strip_item,
+                const RecompRuntimeUiCardView *cards,
+                int count, int active) {
+    const float gap = theme.spacing_sm;
+    const float avail_w = ImGui::GetContentRegionAvail().x;
+    const float card_w = (avail_w - gap * (count - 1)) / count;
+    const float img_w = card_w - theme.spacing_md;
+    float img_h = img_w;
+    for (int i = 0; i < count; ++i)
+        if (cards[i].image && cards[i].aspect > 0.0f)
+            img_h = img_w / cards[i].aspect;
+    const float caption_h = ImGui::GetTextLineHeight() * 2.1f;
+    const float card_h = img_h + caption_h;
+    const bool strip_selected = ui->in_section && strip_row == ui->row_index;
+    for (int i = 0; i < count; ++i) {
+        ImGui::PushID(i);
+        const ImVec2 start = ImGui::GetCursorScreenPos();
+        const bool active_card = i == active;
+        if (ImGui::Selectable("##card", strip_selected && active_card, 0,
+                              ImVec2(card_w, card_h))) {
+            /* A card tap chooses its slot; the row selection stays put. */
+            recomp_runtime_ui_set_item_value(ui, strip_item, i + 1);
+        }
+        ImDrawList *draw = ImGui::GetWindowDrawList();
+        const ImVec2 end(start.x + card_w, start.y + card_h);
+        draw->AddRectFilled(start, end,
+                            u32(active_card ? theme.control_hovered
+                                            : theme.panel));
+        draw->AddRect(start, end,
+                      u32(theme.border), 4.0f, 0, 0.5f);
+        const ImVec2 ip0(start.x + theme.spacing_md * 0.5f,
+                         start.y + theme.spacing_md * 0.5f);
+        const ImVec2 ip1(ip0.x + img_w, ip0.y + img_h);
+        if (cards[i].image) {
+            draw->AddImage((ImTextureID)(uintptr_t)cards[i].image, ip0, ip1);
+        } else {
+            draw->AddRectFilled(ip0, ip1, u32(theme.control));
+            const char *empty = "empty";
+            const ImVec2 ts = ImGui::CalcTextSize(empty);
+            draw->AddText(ImVec2((ip0.x + ip1.x - ts.x) * 0.5f,
+                                 (ip0.y + ip1.y - ts.y) * 0.5f),
+                          u32(theme.text_muted), empty);
+        }
+        draw->PushClipRect(start, end, true);
+        if (cards[i].caption && cards[i].caption[0])
+            draw->AddText(ImVec2(start.x + theme.spacing_md * 0.5f,
+                                 ip1.y + theme.spacing_sm),
+                          u32(active_card ? theme.accent2 : theme.text_muted),
+                          cards[i].caption);
+        draw->PopClipRect();
+        ImGui::PopID();
+        if (i + 1 < count) ImGui::SameLine(0.0f, gap);
+    }
+    ImGui::Dummy(ImVec2(0.0f, 0.0f));
+    if (strip_selected) ImGui::SetScrollHereY(0.0f);
+    ImGui::Separator();
+}
