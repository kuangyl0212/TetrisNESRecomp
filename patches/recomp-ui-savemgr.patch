+int recomp_runtime_ui_set_item_value(RecompRuntimeUi *ui,
+                                     const RecompRuntimeUiItem *item,
+                                     int value) {
+    /* item may be the host's own copy: create_standard clones the item
+     * structs, so pointer identity with ui->config.items does NOT hold.
+     * The pointer only travels back to the host's own callbacks, which
+     * match items by key. */
+    if (!ui || !item || !ui->config.callbacks.set_value) return 0;
+    if (!recomp_runtime_ui_item_enabled(ui, item)) return 0;
+    int current = 0;
+    if (!recomp_runtime_ui_current_value(ui, item, &current)) return 0;
+    if (value == current) return 1;
+    if (!ui->config.callbacks.set_value(ui->config.callbacks.context, item,
+                                        value))
+        return 0;
+    return 1;
+}
