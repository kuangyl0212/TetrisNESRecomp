diff --git a/runner/cyc/cyc_slotshot.cpp b/runner/cyc/cyc_slotshot.cpp
new file mode 100644
index 0000000..272e141
--- /dev/null
+++ b/runner/cyc/cyc_slotshot.cpp
@@ -0,0 +1,88 @@
+// cyc_slotshot.cpp - the save-slot screenshot textures for the runtime menu's
+// row preview (cyc_ui.h, recomp-ui's config.preview). When the System page's
+// save-slot rows are selected, recomp-ui's ImGui presentation asks the host
+// (cyc_ui_menu.c's preview_for_item) for an image, which lands here: each
+// slot's screenshot is loaded once and rebuilt only when the file's
+// modification time changes (a new save or a delete).
+#include "cyc_ui.h"
+
+#include <SDL.h>
+
+#include <cstring>
+#include <cstdio>
+#include <sys/stat.h>
+
+namespace {
+
+constexpr int kSlots = 3;
+
+struct SlotTexture {
+    SDL_Texture *tex;
+    int w, h;
+    long long mtime;   // -1: nothing loaded
+    char path[1240];
+};
+
+SlotTexture s_slots[kSlots];
+SDL_Renderer *s_ren;
+
+bool mtime_of(const char *path, long long *out)
+{
+    struct stat st{};
+    if (stat(path, &st) != 0) return false;   // mingw-w64 / MSVC / POSIX all provide stat()
+    *out = (long long)st.st_mtime;
+    return true;
+}
+
+void release(SlotTexture &s)
+{
+    if (s.tex) SDL_DestroyTexture(s.tex);
+    s.tex = nullptr;
+    s.w = s.h = 0;
+    s.mtime = -1;
+    s.path[0] = 0;
+}
+
+}  // namespace
+
+extern "C" void cyc_slotshot_init(SDL_Renderer *ren)
+{
+    s_ren = ren;
+    for (SlotTexture &s : s_slots) release(s);
+}
+
+extern "C" int cyc_slotshot_texture(int slot, const char *shot_path,
+                                    void **texture, float *aspect)
+{
+    if (slot < 1 || slot > kSlots || !shot_path || !*shot_path || !s_ren) return 0;
+    SlotTexture &s = s_slots[slot - 1];
+    long long m = 0;
+    bool exists = mtime_of(shot_path, &m);
+    if (s.tex && (!exists || std::strcmp(s.path, shot_path) != 0 || m != s.mtime))
+        release(s);
+    if (!s.tex && exists) {
+        SDL_Surface *bmp = SDL_LoadBMP(shot_path);
+        if (bmp) {
+            s.tex = SDL_CreateTextureFromSurface(s_ren, bmp);
+            s.w = bmp->w;
+            s.h = bmp->h;
+            SDL_FreeSurface(bmp);
+            if (s.tex) {
+                snprintf(s.path, sizeof(s.path), "%s", shot_path);
+                s.mtime = m;
+            } else {
+                s.w = s.h = 0;
+            }
+        }
+    }
+    if (!s.tex || s.w <= 0 || s.h <= 0) return 0;
+    if (texture) *texture = (void *)s.tex;
+    if (aspect) *aspect = (float)s.w / (float)s.h;
+    return 1;
+}
+
+extern "C" void cyc_slotshot_shutdown(void)
+{
+    for (SlotTexture &s : s_slots) release(s);
+    s_ren = nullptr;
+}
