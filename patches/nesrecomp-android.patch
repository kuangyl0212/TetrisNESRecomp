--- a/runner/cyc/cyc_settings.c
+++ b/runner/cyc/cyc_settings.c
@@ -6,6 +6,9 @@
 #include <ctype.h>
 #include <stdlib.h>
 #include <string.h>
+#if defined(__ANDROID__)
+#include <SDL_system.h>
+#endif
 #ifdef _WIN32
 #include <windows.h>
 #else
@@ -37,6 +40,18 @@ const char *cyc_settings_default_path(void)
 #ifdef _WIN32
     DWORD n = GetModuleFileNameA(NULL, dir, sizeof(dir));
     if (n == 0 || n >= sizeof(dir)) strcpy(dir, ".");
+#elif defined(__ANDROID__)
+    /* No /proc/self/exe to a writable directory on Android: the executable
+     * lives inside the read-only APK. The wrapper exports the app-internal
+     * storage as NESRECOMP_DATA_DIR (SDL's own path query can fail before
