-/* The host's save directory is beside the executable, independent of cwd. */
+/* The host's save directory is beside the executable, independent of cwd.
+ * On Android the "executable directory" is read-only APK content, so the
+ * save lives under SDL's app-internal storage instead. */
 static bool default_save_path(const char *image_path, const char *extension, char *out, size_t cap)
 {
     char dir[900] = ".";
 #ifdef _WIN32
     DWORD n = GetModuleFileNameA(NULL, dir, sizeof(dir));
     if (n == 0 || n >= sizeof(dir)) strcpy(dir, ".");
+#elif defined(__ANDROID__)
+    {
+        const char *data_dir = getenv("NESRECOMP_DATA_DIR");
+        if (!(data_dir && *data_dir)) data_dir = SDL_AndroidGetInternalStoragePath();
+        if (data_dir && *data_dir) snprintf(dir, sizeof(dir), "%s", data_dir);
+    }
 #else
     ssize_t n = readlink("/proc/self/exe", dir, sizeof(dir) - 1);
     if (n > 0) dir[n] = 0; else strcpy(dir, ".");
diff --git a/runner/cyc/cyc_settings.c b/runner/cyc/cyc_settings.c
