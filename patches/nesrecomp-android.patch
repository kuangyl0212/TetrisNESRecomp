+    const char *data_dir = getenv("NESRECOMP_DATA_DIR");
+    if (data_dir && *data_dir) {
+        snprintf(dir, sizeof(dir), "%s", data_dir);
+    } else {
+        const char *app = SDL_AndroidGetInternalStoragePath();
+        if (app && *app) snprintf(dir, sizeof(dir), "%s", app);
+    }
 #else
     ssize_t n = readlink("/proc/self/exe", dir, sizeof(dir) - 1);
     if (n > 0) dir[n] = 0; else strcpy(dir, ".");
