+/* 24-bit BMP writer for the save-slot preview thumbnails: no decoder
+ * dependency on the menu side (SDL_LoadBMP reads it back). */
+static bool write_bmp(const char *path, const uint32_t *pic, int w, int h)
+{
+    FILE *f = fopen(path, "wb");
+    if (!f) return false;
+    uint32_t row = (uint32_t)w * 3, row_pad = (4 - row % 4) % 4;
+    uint32_t size = 54 + (row + row_pad) * (uint32_t)h;
+    uint8_t hdr[54] = {'B','M'};
+    hdr[2] = (uint8_t)size; hdr[3] = (uint8_t)(size >> 8); hdr[4] = (uint8_t)(size >> 16); hdr[5] = (uint8_t)(size >> 24);
+    hdr[10] = 54; hdr[14] = 40;
+    hdr[18] = (uint8_t)w; hdr[19] = (uint8_t)(w >> 8); hdr[20] = (uint8_t)(w >> 16); hdr[21] = (uint8_t)(w >> 24);
+    hdr[22] = (uint8_t)h; hdr[23] = (uint8_t)(h >> 8); hdr[24] = (uint8_t)(h >> 16); hdr[25] = (uint8_t)(h >> 24);
+    hdr[26] = 1; hdr[28] = 24;
+    bool ok = fwrite(hdr, 1, 54, f) == 54;
+    uint8_t *line = (uint8_t *)malloc(row + row_pad);
+    for (int y = h - 1; ok && y >= 0; --y) {
+        memset(line, 0, row + row_pad);
+        for (int x = 0; x < w; ++x) {
+            uint32_t px = pic[(size_t)y * w + x];   /* ARGB8888, as the texture eats it */
+            line[x * 3] = (uint8_t)px;              /* BMP wants blue first */
+            line[x * 3 + 1] = (uint8_t)(px >> 8);
+            line[x * 3 + 2] = (uint8_t)(px >> 16);
+        }
+        ok = fwrite(line, 1, row + row_pad, f) == row + row_pad;
+    }
+    free(line);
+    return fclose(f) == 0 && ok;
 }
 
