diff --git a/runner/cyc/cyc_ui_imgui.cpp b/runner/cyc/cyc_ui_imgui.cpp
index 6c75cf1..c30fce5 100644
--- a/runner/cyc/cyc_ui_imgui.cpp
+++ b/runner/cyc/cyc_ui_imgui.cpp
@@ -41,6 +41,29 @@ extern "C" bool cyc_ui_init(SDL_Window *win, SDL_Renderer *ren, const CycUiHost
     io.IniFilename = nullptr;
     io.LogFilename = nullptr;
     ImGui::StyleColorsDark();
+#ifdef __ANDROID__
+    /* The menu's touch-friendly mode scales text toward 34-48 px. ImGui's
+     * built-in font is a 13 px bitmap: blown up that far it turns to mush.
+     * Rasterize the system font at the target size instead (the menu keeps
+     * the built-in font as the fallback when the load fails). */
+    {
+        int ow = 0, oh = 0;
+        SDL_GetRendererOutputSize(ren, &ow, &oh);
+        float short_axis = (float)(ow < oh ? ow : oh);
+        if (short_axis <= 0) short_axis = 480.0f;
+        float px = short_axis * 0.036f;
+        if (px < 34.0f) px = 34.0f;
+        if (px > 48.0f) px = 48.0f;
+        const char *fonts[] = {
+            "/system/fonts/Roboto-Regular.ttf",
+            "/system/fonts/Roboto-Regular-2.ttf",
+            "/system/fonts/DroidSans.ttf",
+        };
+        for (const char *path : fonts)
+            if (io.Fonts->AddFontFromFileTTF(path, px)) break;
+        io.Fonts->Build();
+    }
+#endif
     if (!ImGui_ImplSDL2_InitForSDLRenderer(win, ren)) {
         std::fprintf(stderr, "cyc ui: ImGui SDL2 platform initialization failed\n");
         ImGui::DestroyContext(s_ctx);
