+/* Save manager slots (1..3): the state plus a screenshot beside it. */
+static bool save_state_slot_n(int slot)
+{
+    char path[1200], err[256];
+    if (slot < 1) return save_state_slot();
+    state_slot_n(path, sizeof(path), slot);
+    bool ok = save_state_to(path, err, sizeof(err));
+    if (ok) {
+        int pw, ph;
+        const uint32_t *pic = picture(&pw, &ph);
+        if (pic && pw > 0 && ph > 0) {
+            char shot[1240];
+            snprintf(shot, sizeof(shot), "%s.bmp", path);
+            if (!write_bmp(shot, pic, pw, ph)) ok = false;
+        }
+    }
+    note(ok ? "STATE SAVED" : "STATE NOT SAVED", ok ? NULL : err);
+    return ok;
+}
+
+static bool load_state_slot_n(int slot)
+{
+    char path[1200], err[256];
+    if (slot < 1) return load_state_slot();
+    state_slot_n(path, sizeof(path), slot);
+    bool ok = load_state_from(path, err, sizeof(err));
+    note(ok ? "STATE LOADED" : "STATE NOT LOADED", ok ? NULL : err);
+    return ok;
+}
+
+/* The save manager's probe: a slot's state file and its screenshot. */
+static void save_slot_paths(int slot, char *state, size_t state_n, char *shot, size_t shot_n)
+{
+    state_slot_n(state, state_n, slot);
+    snprintf(shot, shot_n, "%s.bmp", state);
