+
+static bool delete_state_slot_n(int slot)
+{
+    char state[1200], shot[1240];
+    if (slot < 1) return false;
+    state_slot_n(state, sizeof(state), slot);
+    snprintf(shot, sizeof(shot), "%s.bmp", state);
+    remove(state);
+    remove(shot);
+    return true;
+}
